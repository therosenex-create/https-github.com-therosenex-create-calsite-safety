# Required. Postgres connection for the app. Do not commit a real password.
DATABASE_URL="postgresql://calsite:calsite@127.0.0.1:5432/calsite"

# Required. Auth.js signs session JWTs with this. Use a long random value on any shared host.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional. Canonical site URL if the host does not infer it. Auth.js reads AUTH_URL when set.
# AUTH_URL="https://example.com"

# Optional. Vitest database. Defaults to calsite_test on localhost when unset.
TEST_DATABASE_URL="postgresql://calsite:calsite@127.0.0.1:5432/calsite_test"

# Optional. Set to true only on a local demo so the sign-in page shows the demo hint.
# DEMO_LOGIN_HINT="true"

# Optional. Required only to run the demonstration seed. Do not reuse this password for a real company.
# DEMO_PASSWORD="change-me-demo-only-10"

# Optional. Must be true to run the seed when NODE_ENV=production. Leave unset on a real database.
# ALLOW_DEMO_SEED="true"

# Optional. database (default) stores files in Postgres, 8 MB max.
# object fails closed until the OBJECT_STORAGE_* variables exist, and this build still does not upload.
DOCUMENT_STORAGE="database"
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional. Leave unset. No invitation email is sent. EMAIL_FROM is reserved for a future provider.
# EMAIL_PROVIDER=
# EMAIL_FROM=

# Optional. Shown by GET /api/health as version when the value is a short token. Hosts may set one of these.
# GIT_SHA=
# COMMIT_REF=
# APP_VERSION=

# This build does not read SENTRY_DSN. Connect the host log drain instead. JSON lines go to stderr.
