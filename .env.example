# Local Postgres. Use a long random value for AUTH_SECRET in any shared environment.
DATABASE_URL="postgresql://calsite:calsite@127.0.0.1:5432/calsite"
TEST_DATABASE_URL="postgresql://calsite:calsite@127.0.0.1:5432/calsite_test"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Set to true only on a local demo. Production should leave this unset.
DEMO_LOGIN_HINT="true"
# Required to load the demonstration company. Do not use this password in production.
DEMO_PASSWORD="change-me-demo-only-10"
